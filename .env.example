# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Models confirmed working against Groq's OpenAI-compatible endpoint (base_url
# https://api.groq.com/openai/v1):
#   GROQ_REASONING_MODEL - openai/gpt-oss-120b, used for regulatory explanation and RFQ
#     wording. It's a reasoning model: pass reasoning_effort="low" and a generous
#     max_tokens, or the reasoning trace consumes the whole budget and content comes
#     back empty.
#   GROQ_SEARCH_MODEL - groq/compound, used for the vendor web-search agent. It runs a
#     real search server-side and returns evidence in message.executed_tools (list of
#     {type, arguments, output, search_results:{results:[{title,url,content,score}]}}).
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=groq/compound
